# ─── Local development (local Supabase stack) ────────────────────────────────
# 1. `pnpm db:start`  → sobe o stack local (Postgres + Auth + Storage + Studio)
#                       e aplica as migrations de `drizzle/`
# 2. `pnpm db:env`    → grava URL/chaves/banco do stack local neste .env.local
# 3. `pnpm db:seed`   → corretor de teste + imóveis publicados
# 4. `pnpm dev`       → http://localhost:3003
# Sem nada disso o front ainda sobe, em modo degradado (sem login nem imóveis).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
POSTGRES_URL=

# Login local: o Google exige OAuth client, então localmente entra-se por senha
# pela rota de teste (ver saída do `pnpm db:seed`). Nunca em produção.
ENABLE_TEST_AUTH=true

# MapTiler (real key needed for map to render) — https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_API_KEY=

# Feature flags (unset = off)
IMOVIL_FEATURE_LEADS=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# ─── Staging / Production ────────────────────────────────────────────────────
# Na Vercel, a integração Supabase ↔ Vercel injeta NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY e POSTGRES_URL(_NON_POOLING). Nada vai pro git.
