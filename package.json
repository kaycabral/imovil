{
  "name": "imovil",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration:pg": "vitest run --config vitest.pg.config.ts",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "type-coverage": "type-coverage --at-least 98 --strict --ignore-catch",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "db:start": "supabase start --workdir . -x realtime,edge-runtime,logflare,vector,supavisor,imgproxy,mailpit && pnpm db:migrate:local",
    "db:stop": "supabase stop --workdir .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:local": "tsx scripts/migrate-local.ts",
    "db:env": "tsx scripts/local-env.ts",
    "db:seed": "tsx scripts/seed.ts",
    "prepare": "node .husky/install.mjs"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "pnpm": {
    "overrides": {
      "vite": "^8.1.6",
      "handlebars@<4.7.10": "^4.7.10",
      "postcss-selector-parser@<6.1.5": "^6.1.6",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.9",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@cbrl/br": "^0.1.0",
    "@cbrl/design": "^0.3.0",
    "@cbrl/env": "^0.1.1",
    "@cbrl/log": "^0.1.0",
    "@cbrl/next": "^0.1.1",
    "@cbrl/pg": "^0.3.0",
    "@cbrl/supabase": "^0.1.1",
    "@hookform/resolvers": "^7.0.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "drizzle-orm": "~0.45.4",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-map-gl": "^8.1.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cbrl/commitlint-config": "^0.2.0",
    "@cbrl/eslint-config": "^0.2.1",
    "@cbrl/prettier-config": "^0.1.0",
    "@cbrl/testing": "^0.3.0",
    "@cbrl/tsconfig": "^0.1.1",
    "@commitlint/cli": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.46.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "supabase": "3.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "type-coverage": "^2.31.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.7",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
