{
  "name": "@tekoa/web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "db:start": "npx -y firebase-tools emulators:start --project tekoa-local",
    "db:exec": "npx -y firebase-tools emulators:exec --only firestore,auth,storage --project tekoa-local --config firebase.json",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "lint": "next typegen && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm db:exec \"playwright test\"",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "type-coverage": "type-coverage --at-least 98 --strict --ignore-catch"
  },
  "dependencies": {
    "@cbrl/design": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "@tekoa/db": "workspace:*",
    "@tekoa/shared": "workspace:*",
    "firebase": "catalog:",
    "firebase-admin": "catalog:",
    "lucide-react": "catalog:",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.6",
    "next-themes": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-map-gl": "^8.1.1",
    "react-markdown": "catalog:",
    "sonner": "catalog:",
    "remark-gfm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cbrl/eslint-base": "workspace:*",
    "@cbrl/testing": "workspace:*",
    "@cbrl/tsconfig-base": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint-config-next": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
