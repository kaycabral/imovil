{
  "name": "@imovil/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "db:start": "supabase start --workdir . -x realtime,edge-runtime,logflare,vector,supavisor,imgproxy,mailpit && pnpm db:migrate",
    "db:stop": "supabase stop --workdir .",
    "db:migrate": "tsx scripts/migrate-local.ts",
    "db:env": "tsx scripts/local-env.ts",
    "db:seed": "tsx scripts/seed.ts",
    "lint": "next typegen && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "type-coverage": "type-coverage --at-least 98 --strict --ignore-catch"
  },
  "dependencies": {
    "@cbrl/br": "^0.1.0",
    "@cbrl/design": "^0.2.0",
    "@cbrl/env": "^0.1.1",
    "@cbrl/log": "^0.1.0",
    "@cbrl/next": "^0.1.0",
    "@cbrl/pg": "^0.3.0",
    "@cbrl/supabase": "^0.1.0",
    "@hookform/resolvers": "catalog:",
    "@imovil/db": "workspace:*",
    "@imovil/shared": "workspace:*",
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "lucide-react": "catalog:",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.5",
    "next-themes": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-map-gl": "^8.1.3",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:",
    "server-only": "catalog:",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cbrl/eslint-config": "^0.2.0",
    "@cbrl/testing": "^0.2.0",
    "@cbrl/tsconfig": "^0.1.0",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-config-next": "catalog:",
    "jsdom": "catalog:",
    "supabase": "3.0.0",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
