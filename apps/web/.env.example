# ─── Local development (emulators) ───────────────────────────────────────────
# Copy this file to .env.local and start with `npm run dev`.
# No real Firebase project needed — emulators handle everything locally.
# Start emulators with: npm run db:start

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Dummy values — emulators accept any non-empty string here.
NEXT_PUBLIC_FIREBASE_API_KEY=demo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=imovil-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=imovil-local
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=imovil-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000

# Admin SDK — emulator host tells the SDK to route to localhost instead of GCP.
FIREBASE_ADMIN_PROJECT_ID=imovil-local
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# MapTiler (real key needed for map to render) — https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_API_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Staging / Production ────────────────────────────────────────────────────
# On App Hosting all vars come from Secret Manager (set via setup.sh or
# `firebase apphosting:secrets:set`). Nothing goes in git.
